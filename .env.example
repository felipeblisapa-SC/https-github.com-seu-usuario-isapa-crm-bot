# Copie este arquivo para ".env" (uso local) ou configure as mesmas variaveis
# em Railway > seu projeto > Variables.

# Chave da API da Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Modelo usado pela Claudia (pode deixar o padrao)
ANTHROPIC_MODEL=claude-sonnet-5

# Token secreto compartilhado com o sync_to_cloud.py (invente uma senha longa e aleatoria)
SYNC_TOKEN=

# Numeros autorizados a falar com a Claudia (voce + equipe), separados por virgula,
# so numeros (com DDI+DDD), sem espacos ou simbolos. Ex:
# ALLOWED_NUMBERS=5548999990000,5548988887777,5547999998888
ALLOWED_NUMBERS=

# Porta do servidor (Railway define isso sozinho, normalmente nao precisa mexer)
PORT=3000

# Usuario e senha pra acessar o painel visual do CRM em /painel (protege os
# dados de clientes/precos/estoque de ficarem abertos pra qualquer um que
# descobrir o link). Sem essas duas variaveis definidas, a rota fica bloqueada.
PAINEL_USER=
PAINEL_SENHA=
